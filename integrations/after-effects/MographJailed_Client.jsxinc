                } else {
                    if (ch.charCodeAt(0) < 32) { fail("Control character in string"); }
                    out += ch;
                }
            }
            fail("Unterminated string");
        }
        function parseNumber() {
            var start = i, token;
            if (text.charAt(i) === "-") { i++; }
            if (text.charAt(i) === "0") { i++; }
            else {
                if (!/[1-9]/.test(text.charAt(i))) { fail("Bad number"); }
                while (/[0-9]/.test(text.charAt(i))) { i++; }
            }
            if (text.charAt(i) === ".") {
                i++;
                if (!/[0-9]/.test(text.charAt(i))) { fail("Bad fraction"); }
                while (/[0-9]/.test(text.charAt(i))) { i++; }
            }
            if (text.charAt(i) === "e" || text.charAt(i) === "E") {
                i++;
                if (text.charAt(i) === "+" || text.charAt(i) === "-") { i++; }
                if (!/[0-9]/.test(text.charAt(i))) { fail("Bad exponent"); }
                while (/[0-9]/.test(text.charAt(i))) { i++; }
            }
            token = text.substring(start, i);
            return Number(token);
        }
        function parseArray() {
            var a = [];
            i++; ws();
            if (text.charAt(i) === "]") { i++; return a; }
            while (i < len) {
                a.push(parseValue()); ws();
                if (text.charAt(i) === "]") { i++; return a; }
                if (text.charAt(i) !== ",") { fail("Expected comma in array"); }
                i++; ws();
            }
            fail("Unterminated array");
        }
        function parseObject() {
            var o = {}, key;
            i++; ws();
            if (text.charAt(i) === "}") { i++; return o; }
            while (i < len) {
                key = parseString(); ws();
                if (text.charAt(i) !== ":") { fail("Expected colon"); }
                i++; ws();
                o[key] = parseValue(); ws();
