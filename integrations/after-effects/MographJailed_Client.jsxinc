            try { if (f.exists) { f.remove(); } } catch (ignoreRemove) {}
            throw e;
        }
        return { file: f, requestId: requestId };
    }

    function Client(cliFile) {
        this.cliFile = cliFile || defaultCliFile();
        this._descriptionCache = null;
    }

    Client.prototype.call = function (command, args) {
        if (!this.cliFile.exists) {
            throw new Error("MOGRAPHJAILED_CLI_NOT_FOUND: " + this.cliFile.fsName);
        }
        var req = makeRequestFile(command, args || {});
        var commandLine = "/bin/zsh -f " + shellQuote(this.cliFile.fsName) + " --request " + shellQuote(req.file.fsName);
        var output;
        try {
            output = system.callSystem(commandLine);
        } finally {
