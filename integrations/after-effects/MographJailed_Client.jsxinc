/* MographJailed After Effects client. ExtendScript / ES3-compatible syntax. */
(function (global) {
    function utf8Bytes(s) {
        var out = [], i, c, next, cp;
        for (i = 0; i < s.length; i++) {
            c = s.charCodeAt(i);
            if (c >= 0xD800 && c <= 0xDBFF && i + 1 < s.length) {
                next = s.charCodeAt(i + 1);
                if (next >= 0xDC00 && next <= 0xDFFF) {
                    cp = 0x10000 + ((c - 0xD800) << 10) + (next - 0xDC00);
                    out.push(0xF0 | (cp >> 18));
                    out.push(0x80 | ((cp >> 12) & 0x3F));
                    out.push(0x80 | ((cp >> 6) & 0x3F));
                    out.push(0x80 | (cp & 0x3F));
                    i++;
                    continue;
                }
            }
            if (c < 0x80) {
                out.push(c);
            } else if (c < 0x800) {
                out.push(0xC0 | (c >> 6));
                out.push(0x80 | (c & 0x3F));
            } else {
                out.push(0xE0 | (c >> 12));
                out.push(0x80 | ((c >> 6) & 0x3F));
                out.push(0x80 | (c & 0x3F));
            }
        }
        return out;
    }

    function base64Utf8(s) {
        var bytes = utf8Bytes(s), chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
        var out = "", i, a, b, c, triple;
        for (i = 0; i < bytes.length; i += 3) {
            a = bytes[i];
            b = (i + 1 < bytes.length) ? bytes[i + 1] : 0;
            c = (i + 2 < bytes.length) ? bytes[i + 2] : 0;
            triple = (a << 16) | (b << 8) | c;
            out += chars.charAt((triple >> 18) & 63);
            out += chars.charAt((triple >> 12) & 63);
            out += (i + 1 < bytes.length) ? chars.charAt((triple >> 6) & 63) : "=";
            out += (i + 2 < bytes.length) ? chars.charAt(triple & 63) : "=";
        }
        return out;
    }

    function shellQuote(s) {
        // Single audited shell boundary. Values never become command syntax.
        return "'" + String(s).replace(/'/g, "'\\''") + "'";
    }


    function isAllowedCommand(command) {
        var allowed = [
            "system.probe", "system.doctor", "system.describe", "runtime.verify", "file.inspect", "file.hash", "file.provenance",
            "asset.manifest", "asset.verify", "search.candidate", "image.inspect", "image.derivative", "image.stats", "image.compare", "storage.preflight",
            "volume.inspect", "temp.create", "temp.clean", "media.inspect",
            "media.timing", "media.frame", "package.create", "report.tech",
            "project.ingest", "expression.lint", "plugin.audit", "project.snapshot",
            "loop.seams", "golden.record", "golden.check", "audit.verify",
            "project.restore", "deps.graph", "handoff.package",
            "index.add", "index.search", "index.verify", "preset.add", "preset.get",
            "host.detect", "ae.render", "c4d.render"
        ];
        var i;
        for (i = 0; i < allowed.length; i++) {
            if (command === allowed[i]) { return true; }
        }
        return false;
    }

    function hasProtocolControl(s) {
        var i, c;
        s = String(s);
        for (i = 0; i < s.length; i++) {
            c = s.charCodeAt(i);
            if (c < 32 || c === 127) { return true; }
        }
        return false;
    }

    function writeRequestLine(f, line) {
        if (!f.writeln(line)) {
            throw new Error("MOGRAPHJAILED_REQUEST_WRITE_FAILED: " + f.error);
        }
    }

    function safeJsonParse(text) {
        var i = 0, len = text.length;
        function fail(msg) { throw new Error("MOGRAPHJAILED_JSON_PARSE: " + msg + " at " + i); }
        function ws() { while (i < len && /[\t\n\r ]/.test(text.charAt(i))) { i++; } }
        function parseString() {
            var out = "", ch, esc, hex, code;
            if (text.charAt(i) !== '"') { fail("Expected string"); }
            i++;
            while (i < len) {
                ch = text.charAt(i++);
                if (ch === '"') { return out; }
                if (ch === "\\") {
