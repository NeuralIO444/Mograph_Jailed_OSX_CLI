    function defaultCliFile() {
        var here = new File($.fileName);
        var root = here.parent.parent.parent;
        return new File(root.fsName + "/dist/mograph-jailed.zsh");
    }

    function makeRequestFile(command, args) {
        var requestId, f, allowed, i, key, value;
        if (!isAllowedCommand(command) || hasProtocolControl(command)) {
            throw new Error("MOGRAPHJAILED_UNSUPPORTED_COMMAND: Command is not allowlisted.");
        }
        requestId = "ae-" + (new Date().getTime()) + "-" + Math.floor(Math.random() * 1000000);
        f = new File(Folder.temp.fsName + "/MographJailed_Request_" + requestId + ".txt");
        f.encoding = "UTF-8";
        f.lineFeed = "Unix";
        if (!f.open("w")) {
            throw new Error("MOGRAPHJAILED_REQUEST_WRITE_FAILED: " + f.error);
        }
        try {
            writeRequestLine(f, "MOGRAPHJAILED_REQUEST 1");
            writeRequestLine(f, "requestId=" + requestId);
            writeRequestLine(f, "command=" + command);
            if (args) {
                allowed = ["path", "pathA", "pathB", "target", "label", "runId", "output", "input", "format", "expectedCliVersion", "expectedProtocolVersion", "expectedFilename", "expectedSha256", "expectedSizeBytes", "expectedModifiedEpoch", "requiredBytes", "maxResults", "timeSeconds", "maxPixels", "minFrames", "threshold", "version", "range", "timeoutSeconds"];
                for (i = 0; i < allowed.length; i++) {
