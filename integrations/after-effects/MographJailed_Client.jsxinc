    Client.prototype.inspectMediaReadOnly = function (path) {
        var before = this.call("file.inspect", { path: path });
        if (!before.ok) { return { ok: false, stage: "inspectBefore", response: before }; }
        var inspect = this.call("media.inspect", { path: path });
        if (!inspect.ok) { return { ok: false, stage: "mediaInspect", response: inspect }; }
        var after = this.call("file.inspect", { path: path });
        if (!after.ok) { return { ok: false, stage: "inspectAfter", response: after }; }
        var same = before.data.sizeBytes === after.data.sizeBytes && before.data.modifiedEpoch === after.data.modifiedEpoch;
        return {
            ok: same,
            unchanged: same,
            verification: "size+mtime",
            before: before.data,
            after: after.data,
            inspect: inspect
